@model BetFormViewModel

@{
    ViewData["Title"] = "Place Bet";
}

<div class="bet-crud-wrapper">
    <h2 class="bet-crud-title">Place Bet: @Model.TeamA vs @Model.TeamB</h2>

    <form asp-action="Create" method="post" class="bet-crud-form">
        <partial name="_BetFormFields" model="Model" />

        <div class="bet-crud-actions">
            <button type="submit" class="bet-btn-save">Place Bet</button>
            <a asp-controller="Matches" asp-action="Index" class="bet-btn-cancel">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
