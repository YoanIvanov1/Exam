@model ProfileViewModel

@{
    ViewData["Title"] = "Profile";
}

<div class="profile-wrapper">

    <div class="profile-header">
        <h1 class="profile-title">Player Profile</h1>

        <form asp-action="Logout" method="post">
            <button type="submit" class="logout-btn">Logout</button>
        </form>
    </div>

    <div class="profile-info-card">
        <h2 class="info-title">Account Details</h2>

        <div class="info-row">
            <span class="info-label">Email:</span>
            <span class="info-value">@Model.Email</span>
        </div>

        <div class="info-row">
            <span class="info-label">Wallet Balance:</span>
            <span class="info-value highlight">@Model.WalletBalance tokens</span>
        </div>

        <div class="info-row">
            <span class="info-label">Bets Placed:</span>
            <span class="info-value">@Model.BetsCount</span>
        </div>
    </div>

    <div class="bet-actions">
        <a asp-controller="Bets" asp-action="Index" class="edit-btn">View My Bets</a>
    </div>

</div>
